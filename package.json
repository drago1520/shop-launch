{
  "name": "shop-launch",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start -c",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "web": "expo start -c --web",
    "@Descr db:sync": "Migrate both Production & Local DB. Alias.",
    "db:sync": "(npm run db:push) && (npm run db:push:prod)",
    "@Descr db:push": "Push changes to Local DB. Generates migrations and applies them.",
    "db:push": "cross-env NODE_ENV=development drizzle-kit push --verbose",
    "@Descr db:push:prod": "Push changes to Production DB",
    "db:push:prod": "cross-env NODE_ENV=production drizzle-kit push --verbose",
    "db:studio": "cross-env NODE_ENV=development drizzle-kit studio --verbose",
    "db:studio:prod": "cross-env NODE_ENV=production drizzle-kit studio --verbose --port 8084",
    "clean": "rm -rf .expo node_modules",
    "format": "pnpm dlx prettier app/ components/ lib/ models/ --write",
    "lint": "expo lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/expo": "^1.3.9",
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/native": "^7.0.0",
    "@rn-primitives/portal": "~1.3.0",
    "@rn-primitives/slot": "^1.2.0",
    "@tanstack/eslint-plugin-query": "^5.89.0",
    "@tanstack/react-query": "^5.89.0",
    "axios": "^1.12.2",
    "better-auth": "^1.3.9",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.2",
    "eslint-config-expo": "^10.0.0",
    "expo": "^54.0.8",
    "expo-constants": "~18.0.8",
    "expo-crypto": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-localization": "^17.0.7",
    "expo-router": "~6.0.6",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.7",
    "lucide-react-native": "^0.511.0",
    "nativewind": "^4.1.23",
    "posthog-react-native": "^4.5.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.10",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "~5.9.2"
  },
  "resolutions": {
    "lightningcss": "1.27.0"
  },
  "private": true
}
