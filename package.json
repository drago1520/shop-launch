{
  "name": "shop-launch",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start -c",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "web": "expo start -c --web",
    "@Descr db:sync": "Migrate both Production & Local DB. Alias.",
    "db:sync": "(npm run db:push) && (npm run db:push:prod)",
    "@Descr db:push": "Push changes to Local DB. Generates migrations and applies them.",
    "db:push": "cross-env NODE_ENV=development drizzle-kit push --verbose",
    "@Descr db:push:prod": "Push changes to Production DB",
    "db:push:prod": "cross-env NODE_ENV=production drizzle-kit push --verbose",
    "db:studio": "cross-env NODE_ENV=development drizzle-kit studio --verbose",
    "db:studio:prod": "cross-env NODE_ENV=production drizzle-kit studio --verbose --port 8084",
    "clean": "rm -rf .expo node_modules",
    "format": "pnpm dlx prettier app/ components/ lib/ models/ --write",
    "lint": "expo lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/expo": "^1.3.9",
    "@react-navigation/native": "^7.0.0",
    "@rn-primitives/portal": "~1.3.0",
    "@rn-primitives/slot": "^1.2.0",
    "better-auth": "^1.3.9",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "expo": "^53.0.19",
    "expo-constants": "^18.0.8",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.3",
    "expo-secure-store": "^15.0.7",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.10",
    "expo-web-browser": "^15.0.7",
    "lucide-react-native": "^0.511.0",
    "nativewind": "^4.1.23",
    "pg": "^8.16.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "~0.20.0",
    "react-native-worklets": "^0.5.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/pg": "^8.15.5",
    "@types/react": "~19.0.14",
    "@typescript-eslint/parser": "^8.43.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~9.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3"
  },
  "resolutions": {
    "lightningcss": "1.27.0"
  },
  "private": true
}
