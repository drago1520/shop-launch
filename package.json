{
  "name": "shop-launch",
  "version": "1.0.0",
  "module": "server/perf/bun-trpc.ts",
  "scripts": {
    "dev": "expo start --go",
    "dev:s": "bun --watch server/perf/bun-trpc.ts",
    "docs:start": "WARNING: MySQL is IP restrited!",
    "start": "bun server/perf/bun-trpc.ts",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "web": "expo start -c --web",
    "clean": "rm -rf .expo node_modules",
    "db:pull": "npm run db:pull:inmarta && npm run db:pull:iimarta && npm run db:pull:imartap",
    "db:pull:inmarta": "npx drizzle-kit pull --config=drizzle.config.inmarta.ts && tsx models/drizzle-fix-single-quote-introspect.ts models/drizzle-inmarta/schema.ts && tsx models/drizzle-fix-missing-comma-introspect.ts models/drizzle-inmarta/schema.ts",
    "db:pull:iimarta": "npx drizzle-kit pull --config=drizzle.config.iimarta.ts && tsx models/drizzle-fix-single-quote-introspect.ts models/drizzle-iimarta/schema.ts && tsx models/drizzle-fix-missing-comma-introspect.ts models/drizzle-iimarta/schema.ts",
    "db:pull:imartap": "npx drizzle-kit pull --config=drizzle.config.imartap.ts && tsx models/drizzle-fix-single-quote-introspect.ts models/drizzle-imartap/schema.ts && tsx models/drizzle-fix-missing-comma-introspect.ts models/drizzle-imartap/schema.ts",
    "format": "prettier app/ components/ lib/ models/ --write --ignore-unknown",
    "lint": "expo lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@better-auth/expo": "^1.3.14",
    "@expo/metro-runtime": "~6.1.2",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@rn-primitives/portal": "~1.3.0",
    "@rn-primitives/slot": "^1.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/eslint-plugin-query": "^5.90.1",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@types/react": "~19.1.10",
    "axios": "^1.12.2",
    "better-auth": "^1.3.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "eslint-config-expo": "~10.0.0",
    "expo": "54.0.13",
    "expo-constants": "~18.0.9",
    "expo-crypto": "~15.0.7",
    "expo-dev-client": "~6.0.15",
    "expo-image": "~3.0.9",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.7",
    "expo-router": "~6.0.12",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.8",
    "lucide-react-native": "^0.511.0",
    "mysql2": "^3.15.2",
    "nativewind": "^4.2.1",
    "posthog-react-native": "^4.6.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-flash-carousel": "^0.4.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-ratings": "^8.1.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "trpc-bun-adapter": "^1.3.0",
    "typescript": "~5.9.2",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "drizzle-kit": "^0.31.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.5.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.20.6"
  },
  "resolutions": {
    "lightningcss": "1.27.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "engines": {
    "node": "22"
  }
}
